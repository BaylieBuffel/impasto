[Plymouth Theme]
Name=impasto
Description=The palette, painted while the machine starts
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/impasto
ScriptFile=/usr/share/plymouth/themes/impasto/impasto.script
